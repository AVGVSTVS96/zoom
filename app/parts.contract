// What every level is made of: the chat in chat order, cut into sets under section headings; a set
// is a title over a body (docs/design.md). scripts/content.ts writes them from data/.

shape Msg
  key: string
  mine: bool
  text: string
  time: string
  image: string
  reply: string
  note: string
  poll: string[]
  top: bool
  tail: bool
  room: string

shape Set
  id: string
  title: string
  count: number
  kept: string
  original: bool
  short: Msg[]
  full: Msg[]

shape Section
  id: string
  title: string
  time: string
  sets: Set[]

shape Content
  totals: string
  anchors: string[]
  sections: Section[]

// A set's messages at Short or Full, as a chat draws them: yours in blue bubbles on the right, hex's
// in white ones on the left. Messages in a row from one side join, the last with a tail. Full adds
// each message's time inside its bubble, the message it replies to, and who forwarded or sent it. A
// tap on a message at Short opens the originals it carries.
component Body
  props
    n: number
    messages: Msg[]
    full: bool
    kept: string
    original: bool
    open: action
  view
    column padding="0 6px 6px"
      if kept != ""
        text kept font="-exact-caption1" color=(kept == "lossless" ? "-exact-secondary-label" : "-exact-system-orange")
      if original
        text "original" font="-exact-caption1" color="-exact-secondary-label" text-transform="uppercase" letter-spacing=0.6
      for m in messages key=m.key
        column id=`${n}-${m.key}` testId=`${n}-${m.key}` press=open(`${n}-${m.key}`)
          align-items=(m.mine ? "flex-end" : "flex-start") padding-top=(m.top ? 8 : 2)
          Bubble(m=m, full=full)

// One message's bubble, Telegram's shape: 16pt corners, 8pt where it joins the next or last message
// from the same side, and the tail on the last of a run. At Full the time sits on the last line, in
// room the text keeps for it (`room`), as Telegram sets it: the time's row is pulled up into it.
component Bubble
  props
    m: Msg
    full: bool
  derive bare = m.image != "" and m.text == "" and m.poll.length == 0
  derive ink = m.mine ? "bubbleOutInk" : "-exact-label"
  derive meta = m.mine ? "bubbleOutMeta" : "bubbleInMeta"
  derive accent = m.mine ? "bubbleOutInk" : "linkInk"
  // The tail sits beside the bubble, not in it: a rounded view clips what it holds. It goes under the
  // bubble, which keeps the time in its corner on top.
  view
    column position="relative" max-width="min(90%, 32rem)" min-width=0
      if m.tail
        Tail(mine=m.mine)
      column position="relative" box-sizing="border-box" padding=(bare ? "2px" : "6px 11px 6px 12px") gap=4
        background-color=(m.mine ? "bubbleOut" : "bubbleIn") accent-color=accent -exact-tint-color=accent
        border-top-left-radius=(m.mine or m.top ? 16 : 8) border-bottom-left-radius=(m.mine or m.tail ? 16 : 8)
        border-top-right-radius=(not m.mine or m.top ? 16 : 8) border-bottom-right-radius=(not m.mine or m.tail ? 16 : 8)
        if full and m.note != ""
          text m.note font="-exact-subheadline" font-weight=600 color=accent line-clamp=2
        if full and m.reply != ""
          row gap=7 padding="5px 8px 5px 0" border-radius=6 overflow="hidden" background-color=(m.mine ? "quoteOut" : "quoteIn") margin="2px 0"
            box width=3 align-self="stretch" background-color=accent
            text m.reply font="-exact-subheadline" color=ink line-clamp=2 flex=1 min-width=0
        // A photo over words runs to the bubble's edges, as Telegram's does; the bubble rounds it.
        if m.image != ""
          column position="relative" margin=(bare ? "0" : "-6px -11px 2px -12px")
            image m.image width="100%" max-width=(bare ? "18rem" : "none") border-radius=(bare ? 14 : 0) object-fit="cover" aria-label="Photo"
            if full and bare
              text m.time position="absolute" right=6 bottom=6 padding="1px 7px" border-radius=10 background-color="rgba(0,0,0,0.42)"
                font-size=11 color="#ffffff" font-variant-numeric="tabular-nums"
        if m.text != ""
          text (full and m.poll.length == 0 ? `${m.text}${m.room}` : m.text) markup="markdown" font="-exact-body"
            font-weight=(m.poll.length > 0 ? 600 : 400) color=ink overflow-wrap="break-word" hyphens="none"
        if m.poll.length > 0
          text "Poll" font="-exact-footnote" color=meta
        if full and m.text != "" and m.poll.length == 0
          row justify-content="flex-end" margin-top=-18 pointer-events="none"
            Stamp(time=m.time, color=meta)
        for o in m.poll key=o
          row gap=10 align-items="flex-start" padding="6px 0 2px"
            box width=18 height=18 margin-top=2 border-radius=9 border-width=1.5 border-style="solid" border-color=meta box-sizing="border-box" flex-shrink=0
            text o font="-exact-body" color=ink flex=1 min-width=0
        if full and m.poll.length > 0
          row justify-content="flex-end"
            Stamp(time=m.time, color=meta)

component Stamp
  props
    time: string
    color: string
  view
    text time font="-exact-caption2" color=color white-space="nowrap" flex-shrink=0

// Telegram's tail (ChatMessageBubbleImages.swift): below the 16pt corner a foot curls out 5pt, its
// upper edge cut by an ellipse. Telegram draws it in a 39 by 33 box with the bubble's edge at
// 33; this is that box's bottom-right 22.5 by 17, the bubble's edge 6 in from the right.
component Tail
  props
    mine: bool
  view
    svg position="absolute" bottom=0 left=(mine ? "auto" : "-6px") right=(mine ? "-6px" : "auto") width=22.5 height=17 viewBox="0 0 22.5 17" aria-hidden=true
      path d=(mine ? "M 0 0 L 16.5 0 L 16.5 8.5 A 11.5 10.5 0 0 0 21.25 17 L 21 17 Q 7.5 17 7.5 8.5 L 7.5 9 L 0 9 Z" : "M 22.5 0 L 6 0 L 6 8.5 A 11.5 10.5 0 0 1 1.25 17 L 1.5 17 Q 15 17 15 8.5 L 15 9 L 22.5 9 Z")
        fill=(mine ? "bubbleOut" : "bubbleIn")

// A section heading, as a chat marks a new day: a capsule centred over the wallpaper.
component Heading
  props
    title: string
    time: string
  view
    row justify-content="center" width="100%"
      row role="heading" aria-level=2 gap=6 align-items="baseline" max-width="100%" box-sizing="border-box"
        padding="3px 10px 4px" border-radius=12 background-color="service"
        text title font="-exact-footnote" font-weight=600 color="serviceInk" line-clamp=1 min-width=0
        text time font="-exact-footnote" color="serviceMeta" font-variant-numeric="tabular-nums" flex-shrink=0

// The map beside the chat on a wide screen: every section's sets in one rounded group, the set being
// read marked.
component Map
  props
    content: Content
    current: string
    open: action
  view
    column width="100%" padding="8px 16px 0" box-sizing="border-box"
      text content.totals font="-exact-footnote" color="-exact-secondary-label" text-align="center" padding="8px 0 0" testId="side-totals"
      for s in content.sections key=s.id
        column padding="22px 0 8px"
          Heading(title=s.title, time=s.time)
        column border-radius=16 overflow="hidden" background-color="bubbleIn"
          for t in s.sets key=t.id
            row testId=`side-${t.id}` press=open(t.id) align-items="baseline" gap=8 padding="11px 14px" position="relative"
              background-color=(t.id == current ? "current" : "transparent")
              text t.title font="-exact-headline" color="-exact-label" flex=1 min-width=0
              text `${t.count}` font="-exact-subheadline" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
              if t.id != (match s.sets.at(-1) { case some(x) => x.id, case none => "" })
                box position="absolute" left=14 right=0 bottom=0 height=0.5 background-color="-exact-separator"
