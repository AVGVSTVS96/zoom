// zoom: one chat at three levels. Pinch out for less, in for more: every message as sent,
// Muse Wonder's concise version of each exchange, and the map of sections. Each level holds
// the same exchanges in the same order, so a zoom keeps your place (docs/design.md).
use Row, Content, Level, Bubble, SectionHead, Caption, Entry from "./parts.contract"

routes nav
  home "/"

shape Viewport
  width: number
  prefersReducedMotion: bool

component App
  resource content = loadContent() as shape Content
  resource viewport = exactViewport() as shape Viewport
  // Where you are: the level, and the exchange (a set's id) you were reading. Both outlast a quit.
  state level = 3 persist
  state focus = "" persist
  state restored = false
  // The rows each level shows in view now, so a zoom lands on the first of them.
  state visible = []
  state lensScale = 1
  state lensX = 0
  state lensY = 0
  derive still = viewport.prefersReducedMotion
  derive rows = level == 1 ? content.one : level == 2 ? content.two : content.three
  derive here = match rows.filter(r => visible.includes(r.key)).at(0) { case some(r) => r.set, case none => focus }

  task restore when current(content) and not restored
    after(1, land, wait=update)

  action land
    restored = true
    if focus != ""
      scrollIntoView(`${level}-${focus}`, block="start")

  action seen(key: string, e: IntersectionObserverEntry)
    if e.isIntersecting
      if not visible.includes(key)
        visible = visible.concat([key])
    else
      visible = visible.filter(k => k != key)

  // A zoom lands the next level on the exchange you were reading, then fades it in.
  action zoomTo(next: number)
    if next >= 1 and next <= 3 and next != level
      scrollIntoView(`${next}-${here}`, block="start")
      focus = here
      level = next
      haptic("selection")

  // Opening one exchange from the map or the concise level: the level below, at that exchange.
  action open(set: string)
    if level > 1
      scrollIntoView(`${level - 1}-${set}`, block="start")
      focus = set
      level = level - 1
      haptic("selection")

  action lensGeometry(bw: number, bh: number, pw: number, ph: number)
    lensX = 0

  // The pinch scales the page live under the fingers; letting go past a step zooms a level.
  action released(x: number, y: number, scale: number, vx: number, vy: number, vscale: number)
    lensScale = 1
    lensX = 0
    lensY = 0
    if scale < 0.84 or (scale < 0.97 and vscale < -0.6)
      zoomTo(level + 1)
    else if scale > 1.16 or (scale > 1.03 and vscale > 0.6)
      zoomTo(level - 1)

  view
    main testId="root" navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll=`level-${level}` position="absolute" inset=0 display="flex" flex-direction="column"
          header
            text content.title role="heading" aria-level=2
            text (level == 1 ? `${content.messages} messages · ${content.span}` : level == 2 ? (content.kept != "" ? `Muse Wonder · ${content.kept}` : "Muse Wonder · rewriting") : `${content.three.filter(r => r.kind == "section").length} sections · tap one to read it`) testId="subtitle"
          column flex=1 min-height=0 overflow="hidden" position="relative" padding=0 border-width=0
            column id="lens" width="100%" height="100%" box-sizing="border-box" position="relative" padding=0 margin=0 border-width=0
              scale=lensScale translate=`${lensX}px ${lensY}px` transition=(still ? "none" : "scale -exact-spring(260, 26, 1), translate -exact-spring(260, 26, 1)")
              for n in [1, 2, 3] key=n
                scroll id=`level-${n}` position="absolute" inset=0 inert=(level != n) aria-hidden=(level != n)
                  opacity=(level == n ? 1 : 0) transition=(still ? "none" : "opacity 220ms ease") testId=`level-${n}`
                  column transformDragFor="lens" touch-action="pan-y" transformgeometry=lensGeometry transformrelease=released
                    padding="4px 0 120px" align-items="center" min-height="100%" box-sizing="border-box"
                    Level(rows=(n == 1 ? content.one : n == 2 ? content.two : content.three), seen=seen, open=open, wide=viewport.width >= 700)
          row position="absolute" left=0 right=0 bottom="calc(env(safe-area-inset-bottom) + 12px)" justify-content="center" pointer-events="none"
            row backgroundMaterial="glass" border-radius=22 padding=4 pointer-events="auto" width="19rem" max-width="calc(100% - 48px)"
              row role="radiogroup" aria-label="Zoom" flex=1
                button role="radio" aria-checked=(level == 1) press=zoomTo(1) testId="zoom-1" flex=1
                  text "Messages"
                button role="radio" aria-checked=(level == 2) press=zoomTo(2) testId="zoom-2" flex=1
                  text "Concise"
                button role="radio" aria-checked=(level == 3) press=zoomTo(3) testId="zoom-3" flex=1
                  text "Map"
