// What every level is made of: the chat in chat order, cut into sets under section headings; a set
// is a title over a body (docs/design.md). scripts/content.ts writes them from data/.

shape Msg
  key: string
  mine: bool
  text: string
  time: string
  image: string
  reply: string
  note: string
  poll: string[]

shape Set
  id: string
  title: string
  count: number
  kept: string
  original: bool
  short: Msg[]
  full: Msg[]

shape Section
  id: string
  title: string
  time: string
  sets: Set[]

shape Content
  totals: string
  anchors: string[]
  sections: Section[]

// One level of the chat. Map is titles only, Short is Muse Wonder's rewrite, Full the originals. Every
// place a zoom can hold has an id, `<level>-<key>`, and reports when it comes into view; `current` is
// the set a map beside the chat marks as the one being read.
component Level
  props
    n: number
    content: Content
    current: string
    seen: action
    open: action
  view
    column width="100%" max-width="40rem" padding=(n == 3 ? "8px 16px 0 22px" : "8px 20px 0 22px") box-sizing="border-box" gap=0
      if n == 3
        text content.totals font="-exact-footnote" color="-exact-secondary-label" padding="8px 0 0" testId="totals"
      for s in content.sections key=s.id
        column id=`${n}-s-${s.id}` intersect=seen(`${n}-s-${s.id}`) intersect-margin="-40px 0px 0px 0px"
          row align-items="baseline" gap=8 padding=(n == 3 ? "22px 0 4px" : "34px 0 2px")
            text s.title font="-exact-footnote" font-weight=600 color="-exact-secondary-label" text-transform="uppercase" letter-spacing=0.6
              flex=1 min-width=0 role="heading" aria-level=2
            text s.time font="-exact-footnote" color="-exact-tertiary-label" font-variant-numeric="tabular-nums"
          for t in s.sets key=t.id
            column id=`${n}-${t.id}~`
              Title(set=t, n=n, current=(t.id == current), seen=seen, open=open)
              if n == 2
                Body(n=n, messages=t.short, full=false, original=t.original, seen=seen, open=open)
              else if n == 1
                Body(n=n, messages=t.full, full=true, original=false, seen=seen, open=open)

// The handle: a set's title, the same words at the same left edge at every level. On the map it is the
// whole row, with how many messages it stands for; at Full it carries how much of it the rewrite kept.
component Title
  props
    set: Set
    n: number
    current: bool
    seen: action
    open: action
  view
    column id=`${n}-${set.id}` testId=`${n}-${set.id}` intersect=seen(`${n}-${set.id}`) intersect-margin="-40px 0px 0px 0px"
      press=open(set.id) gap=2 padding=(n == 3 ? "9px 10px" : "18px 0 8px") margin=(n == 3 ? "0 -10px" : "0")
      border-radius=10 background-color=(current ? "-exact-secondary-background" : "transparent")
      row align-items="baseline" gap=8
        text set.title font=(n == 3 ? "-exact-body" : "-exact-headline") color="-exact-label" flex=1 min-width=0
        if n == 3
          text `${set.count}` font="-exact-footnote" color="-exact-tertiary-label" font-variant-numeric="tabular-nums"
      if n == 1 and set.kept != ""
        text set.kept font="-exact-caption1" color=(set.kept == "lossless" ? "-exact-tertiary-label" : "-exact-system-orange")

// A set's messages: yours on the right in a bubble, hex's full width as text. A tap on a message at
// Short opens the originals it carries.
component Body
  props
    n: number
    messages: Msg[]
    full: bool
    original: bool
    seen: action
    open: action
  view
    column gap=10 padding="0 0 6px"
      if original
        text "original" font="-exact-caption1" color="-exact-tertiary-label" text-transform="uppercase" letter-spacing=0.6
      for m in messages key=m.key
        column id=`${n}-${m.key}` testId=`${n}-${m.key}` intersect=seen(`${n}-${m.key}`) intersect-margin="-40px 0px 0px 0px" press=open(m.key)
          align-items=(m.mine ? "flex-end" : "stretch") gap=4
          if full
            text (m.note != "" ? `${m.mine ? "you" : "hex"}  ${m.time} · ${m.note}` : `${m.mine ? "you" : "hex"}  ${m.time}`) font="-exact-caption1" color="-exact-tertiary-label" font-variant-numeric="tabular-nums"
          column max-width=(m.mine ? "85%" : "100%") gap=6
            padding=(m.mine ? (m.image != "" and m.text == "" ? "4px" : "8px 13px") : "0px") border-radius=18
            background-color=(m.mine ? "-exact-secondary-background" : "transparent")
            if full and m.reply != ""
              row gap=8 padding="2px 0"
                box width=2 border-radius=1 background-color="-exact-separator"
                text m.reply font="-exact-footnote" color="-exact-secondary-label" line-clamp=2 flex=1 min-width=0
            if m.image != ""
              image m.image width="100%" max-width="18rem" border-radius=14 object-fit="cover" aria-label="Photo"
            if m.text != ""
              text m.text markup="markdown" font="-exact-body" color="-exact-label" overflow-wrap="break-word"
            for o in m.poll key=o
              row gap=8 align-items="center"
                image "symbol:circle" width=15 height=15 color="-exact-tertiary-label"
                text o font="-exact-subheadline" color="-exact-label" flex=1 min-width=0
