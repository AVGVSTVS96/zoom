#!/usr/bin/env bash
# Runs on hex's machine: drives zoom on the Mac's iPhone Duo simulator ("zoom Duo") with Exact's agent in
# each pose, light and dark, and copies the screenshots back. Every pose starts from a fresh store, so the
# app opens as it does the first time: at Short on the newest set. With no ops it shoots every level the
# pose has (the map is a stop only where it doesn't sit beside the chat); ops are the agent's
# (`bun exact.mjs agent --help`), and a screenshot named `<name>.png` lands as
# <name>-<pose>-<appearance>.png in $SHOTS (~/hex/scratch/zoom/shots/<commit>/).
#   scripts/sim
#   POSES=cover-up APPEARANCES=dark scripts/sim "clock data" "tap page-2 pinch 0.7" "clock settle" "screenshot pinch.png"
#   TESTS=1 POSES= scripts/sim    runs app.test.contract on the simulator first (the pinch needs a real touch host)
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
shots=${SHOTS:-$HOME/hex/scratch/zoom/shots/$(git -C "$here" rev-parse --short HEAD)}
POSES=${POSES-cover-up open-up open-side}
APPEARANCES=${APPEARANCES:-light dark}
mkdir -p "$shots"
# One zoom run at a time, and one build on the Mac at a time, shared with hex Exact's scripts.
locks=~/.local/share/hex-exact
mkdir -p "$locks" && exec 8>"$locks/zoom-sim.lock" && flock 8
exec 9>"$locks/sim-build.lock" && flock 9

ssh -o ConnectTimeout=15 -o BatchMode=yes mac true </dev/null || { echo "the Mac didn't answer" >&2; exit 1; }
bun "$here/scripts/content.ts"
rsync -a --delete --exclude .git --exclude /app/target --exclude /app/.exact --exclude node_modules "$here/" mac:Developer/zoom/
ssh mac bash -s <<'MAC'
set -euo pipefail
. ~/Developer/zoom/scripts/mac-env
# The Duo simulator runs iOS 27.1, which Xcode-beta carries.
export DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer
id=$(xcrun simctl list devices -j | jq -r '[.devices[][] | select(.name == "zoom Duo")][0].udid // empty')
if [ -z "$id" ]; then
  runtime=$(xcrun simctl list runtimes -j | jq -r '[.runtimes[] | select(.name == "iOS 27.1")][0].identifier')
  id=$(xcrun simctl create "zoom Duo" "iPhone Duo" "$runtime")
fi
xcrun simctl boot "$id" 2>/dev/null || true
xcrun simctl bootstatus "$id" -b >/dev/null
hub=~/Developer/zoom-build/devicehub-sim
mkdir -p ~/Developer/zoom-build
[ "$hub" -nt ~/Developer/zoom/scripts/devicehub.c ] || {
  xcrun -sdk iphonesimulator clang -arch arm64 -mios-simulator-version-min=27.0 -O2 -o "$hub" \
    ~/Developer/zoom/scripts/devicehub.c -framework IOKit -framework CoreFoundation
  codesign -f -s - "$hub" 2>/dev/null
}
cd ~/Developer/zoom/app
bun exact.mjs ios --sim "$id" --json 2>~/Developer/zoom-build/sim-build.log | tail -1 | jq -c '{path, installed}' ||
  { tail -30 ~/Developer/zoom-build/sim-build.log >&2; exit 1; }
MAC
flock -u 9

# ssh joins its arguments into one command line, so each is quoted for the Mac's shell. The script
# comes in on stdin, so every command in it reads /dev/null instead, or it would eat the script's rest.
ssh mac bash -s -- "$(printf "%q " "$POSES" "$APPEARANCES" "${TESTS:-}" "$@")" <<'MAC'
set -euo pipefail
poses=$1 appearances=$2 tests=$3
shift 3
. ~/Developer/zoom/scripts/mac-env
export DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer
# Exact's display reads go through scripts/display/xcrun, which names the screen the pose is on.
export PATH=~/Developer/zoom/scripts/display:$PATH
id=$(xcrun simctl list devices -j | jq -r '[.devices[][] | select(.name == "zoom Duo")][0].udid')
xcrun simctl status_bar "$id" override --time 9:41 --batteryLevel 100 --cellularBars 4 </dev/null 2>/dev/null || true
hub=~/Developer/zoom-build/devicehub-sim
hubdo() { xcrun simctl spawn "$id" "$hub" "$@" </dev/null; }
drive() { bun exact.mjs agent ios --sim "$id" --scale 3 "$@" 2>&1 </dev/null; }
out=~/Developer/zoom-build/shots
rm -rf "$out" && mkdir -p "$out"
cd ~/Developer/zoom/app
[ -z "$tests" ] || bun exact.mjs test ios --sim "$id" 2>&1 </dev/null | grep -E "^test|passed|failed|line [0-9]+:" | cut -c1-400 || true
hinge_at=
for pose in $poses; do
  case ${pose%-*} in cover) hinge=0 SIM_DISPLAY=LCD ;; open) hinge=180 SIM_DISPLAY=LCD-1 ;; esac
  export SIM_DISPLAY
  case ${pose##*-} in up) orientation=portrait ;; side) orientation=landscape-right ;; esac
  if [ "$hinge" != "$hinge_at" ]; then
    hubdo hinge "$hinge" "${hinge_at:-$([ "$hinge" -gt 90 ] && echo 0 || echo 180)}"
    sleep 3
    hinge_at=$hinge
  fi
  hubdo orientation "$orientation"; sleep 1; hubdo orientation "$orientation"
  ops=("$@")
  if [ ${#ops[@]} -eq 0 ]; then
    ops=("clock data" "clock settle" "screenshot short.png" "tap zoom-1" "clock settle" "screenshot full.png")
    highest=$(drive --json "clock data" "state highest" | tail -1)
    jq -e '.value == 3' <<<"$highest" >/dev/null && ops+=("tap zoom-3" "clock settle" "screenshot map.png")
    ops+=("state viewport")
  fi
  for appearance in $appearances; do
    xcrun simctl ui "$id" appearance "$appearance" </dev/null
    run=()
    for op in "${ops[@]}"; do
      read -ra w <<<"$op"
      case $op in "screenshot "*.png*) run+=("screenshot $out/${w[1]%.png}-$pose-$appearance.png ${w[*]:2}") ;; *) run+=("$op") ;; esac
    done
    echo "== $pose $appearance"
    drive --storage "$pose-$appearance" --reset-storage "${run[@]}" | tail -40
  done
done
MAC
rsync -a mac:Developer/zoom-build/shots/ "$shots/"
ls "$shots"
