// The rows every level is made of. scripts/content.ts writes them, one list per level.

shape Row
  key: string
  kind: string
  set: string
  mine: bool
  text: string
  title: string
  detail: string
  image: string
  reply: string
  note: string
  waiting: string
  count: number
  tint: string
  poll: string[]
  flag: string

shape Content
  title: string
  span: string
  messages: number
  kept: string
  lossless: bool
  one: Row[]
  two: Row[]
  three: Row[]

component Level
  props
    rows: Row[]
    seen: action
    open: action
    wide: bool
  view
    column width="100%" max-width=(wide ? "45rem" : "100%") padding="0 16px" box-sizing="border-box"
      for r in rows key=r.key
        column id=r.key intersect=seen(r.key) intersect-margin="-90px 0px 0px 0px" testId=r.key
          if r.kind == "section"
            SectionHead(row=r)
          else if r.kind == "set"
            Caption(row=r)
          else if r.kind == "entry"
            Entry(row=r, open=open(r.set))
          else
            Bubble(row=r, open=open(r.set))

// A section's title opens it at every level, in its colour.
component SectionHead
  props
    row: Row
  view
    row align-items="center" gap=10 padding="28px 4px 6px"
      box width=10 height=10 border-radius=5 background-color=row.tint
      text row.title font="-exact-title3" font-weight=700 flex=1 role="heading" aria-level=3
      text `${row.count}` font="-exact-subheadline" color="-exact-secondary-label" font-variant-numeric="tabular-nums"

// An exchange's one line, over its messages: what it is and when.
component Caption
  props
    row: Row
  view
    row align-items="baseline" gap=8 padding="14px 4px 6px"
      text row.title font="-exact-footnote" font-weight=600 color="-exact-secondary-label" flex=1
      text row.detail font="-exact-caption1" color="-exact-tertiary-label"

// A message: yours on the right, hex's on the left. Above level 1 a tap opens its originals.
component Bubble
  props
    row: Row
    open: action
  view
    column align-items=(row.mine ? "flex-end" : "flex-start") padding="3px 0" gap=4
      if row.flag != ""
        row gap=6 align-items="center" padding="2px 4px 4px"
          image "symbol:alert" color="-exact-system-orange" width=13 height=13
          text row.flag font="-exact-caption1" color="-exact-system-orange"
      column max-width="min(86%, 560px)" padding=(row.image != "" and row.text == "" ? 4 : "9px 14px 8px") gap=6 border-radius=20
        background-color=(row.mine ? "-exact-label" : "-exact-secondary-background")
        press=open
        if row.reply != ""
          row gap=8 padding="2px 0"
            box width=2 border-radius=1 background-color=(row.mine ? "-exact-background" : "-exact-system-blue") opacity=0.7
            text row.reply font="-exact-footnote" line-clamp=2 color=(row.mine ? "-exact-background" : "-exact-secondary-label") flex=1 min-width=0
        if row.image != ""
          image row.image width="100%" max-width=300 border-radius=16 object-fit="cover" aria-label="Photo"
        if row.text != ""
          text row.text markup="markdown" font="-exact-body" color=(row.mine ? "-exact-background" : "-exact-label") overflow-wrap="break-word"
        for o in row.poll key=o
          row gap=8 align-items="center" padding="4px 0"
            image "symbol:circle" width=16 height=16 color="-exact-secondary-label"
            text o font="-exact-subheadline" color="-exact-label" flex=1
        if row.note != "" or row.detail != ""
          text (row.note != "" ? `${row.note} · ${row.detail}` : row.detail) font="-exact-caption2" align-self="flex-end"
            color=(row.mine ? "-exact-background" : "-exact-tertiary-label") opacity=(row.mine ? 0.6 : 1)

// One exchange on the map: its line, when, how many messages, and what it leaves you with.
component Entry
  props
    row: Row
    open: action
  view
    row gap=12 padding="10px 4px" align-items="flex-start" press=open aria-label=row.title
      box width=3 align-self="stretch" border-radius=2 background-color=row.tint opacity=0.5
      column flex=1 min-width=0 gap=3
        text row.title font="-exact-body" color="-exact-label"
        text `${row.detail} · ${row.count == 1 ? "1 message" : `${row.count} messages`}` font="-exact-footnote" color="-exact-secondary-label"
        if row.waiting != ""
          row gap=6 align-items="flex-start" padding="4px 0 0"
            image "symbol:forward-chevron" width=11 height=11 color=row.tint margin="3px 0 0"
            text row.waiting font="-exact-subheadline" color="-exact-label" flex=1 min-width=0
      image "symbol:forward-chevron" width=12 height=12 color="-exact-tertiary-label" align-self="center"
